# Copy this file to .env and fill in your values. Never commit .env.

# Open Exchange Rates App ID (https://openexchangerates.org/signup/free)
OXR_APP_ID=your_app_id_here

# How long exchange rates stay cached, in seconds.
# The free plan updates rates hourly and allows 1,000 requests/month;
# 3600 keeps a single process at most ~744 requests/month.
CACHE_TTL_SECONDS=3600

# Folder where historical rates are cached permanently (past days never change),
# so restarts do not spend quota again. Leave empty to keep them in memory only.
HISTORY_CACHE_DIR=.cache/historical

# Timeout for calls to Open Exchange Rates, in seconds.
REQUEST_TIMEOUT_SECONDS=10

# Comma-separated list of origins allowed by CORS (use * to allow any).
# The defaults match the local frontend server (python -m http.server 5500 -d frontend).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: Upstash Redis (https://upstash.com) for caches that survive restarts.
# Needed on hosts whose disk is wiped on restart (e.g. Render's free plan).
# Use the REST URL and the REST token of your database. Set both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests kept for conversions each month: the history chart pauses instead
# of spending them (checked against Open Exchange Rates' usage.json).
QUOTA_RESERVE=150
